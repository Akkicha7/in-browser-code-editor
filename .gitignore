# =============================================================================
# Dependencies
# =============================================================================
# Ignore the node_modules directory, which contains downloaded dependencies.
# These should be installed via `npm install` or `yarn install`.
/node_modules

# Lockfiles from other package managers. We use package-lock.json, which should be committed.
# yarn.lock
# pnpm-lock.yaml

# =============================================================================
# Build & Distribution
# =============================================================================
# Ignore compiled output, distribution folders, and build artifacts.
# While this is a simple client-side project, this is good practice for future-proofing.
/dist
/build
/out
/.parcel-cache
/.cache

# =============================================================================
# Logs
# =============================================================================
# Ignore log files, which can be verbose and environment-specific.
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# =============================================================================
# Local Environment & Configuration
# =============================================================================
# Ignore environment variable files. These contain sensitive information
# and are specific to each developer's machine. A .env.example should be
# committed instead.
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# =============================================================================
# IDE & Editor Configuration
# =============================================================================
# Ignore editor-specific settings and project files.
# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains IDEs (IntelliJ, WebStorm, etc.)
.idea/

# Sublime Text
*.sublime-project
*.sublime-workspace

# =============================================================================
# Operating System Files
# =============================================================================
# Ignore OS-specific files that are not part of the project.
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# =/============================================================================
# Testing
# =============================================================================
# Ignore test coverage reports and temporary test files.
/coverage
/lcov-report
/.nyc_output